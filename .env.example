# NotispaceAI / OpenAI Compatible API Configuration
# Isi salah satu: NOTISPACE_API_KEY atau OPENAI_API_KEY
NOTISPACE_API_KEY=your_notispace_api_key_here
NOTISPACE_BASE_URL=https://api.notispace.com/v1

# Alternatif standard OpenAI format (jika Notispace menggunakan endpoint OpenAI compatible)
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=

# Model Configuration
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Vector DB Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# App Configuration
APP_ENV=development
APP_PORT=8000
